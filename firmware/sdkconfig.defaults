# Wspolne ustawienia projektu. Kazda pozycja ma uzasadnienie - patrz AGENTS.md.

# --- Flash / partycje ---
# 4 MB flash na C3 SuperMini. Bez OTA (PoC), wiec jedna duza partycja aplikacji.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# --- Bluetooth: tylko BLE, stack NimBLE ---
# NimBLE, nie Bluedroid: C3 nie ma Bluetooth Classic, a NimBLE zjada wyraznie mniej
# internal SRAM (C3 nie ma PSRAM, wiec nie ma gdzie uciec - AGENTS.md 4.5).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# Gdy urzadzenie zapomni bondu (np. po sparowaniu z innym hostem), probuje sparowac
# sie od nowa, mimo ze my wciaz mamy stary klucz. NimBLE zglasza wtedy
# BLE_GAP_EVENT_REPEAT_PAIRING - ale pyta o decyzje FUNKCJE ZWROTNA POLACZENIA
# (ble_gap_repeat_pairing_event() wola ble_gap_call_conn_event_cb), a dla linkow
# centralnych trzyma ja esp_hidh, ktory tego zdarzenia nie obsluguje. Globalny
# listener tu nie pomoze, bo jego wynik jest ignorowany. Ta opcja kaze wiec stackowi
# samemu usunac nieaktualny bond i powtorzyc parowanie.
CONFIG_BT_NIMBLE_HANDLE_REPEAT_PAIRING_DELETION=y

# Trzy jednoczesne linki: 2x central (klawiatura, mysz) + 1x peripheral (PC).
#
# ALE wartosc jest USTAWIONA WYZEJ NIZ 3 CELOWO, i to jest wazne. W ble_gap.c:323
# NimBLE deklaruje cztery tablice wymiarowane liczba polaczen:
#
#   uint16_t g_max_tx_time[MYNEWT_VAL(BLE_MAX_CONNECTIONS) + 1];
#
# i indeksuje je... uchwytem polaczenia:
#
#   g_max_tx_time[conn_handle] = event.data_len_chg.max_tx_time;   /* ble_gap.c:2963 */
#
# conn_handle nadaje kontroler i NIE jest to maly indeks ograniczony liczba polaczen.
# U nas uchwyty to 1, 3 i 4, a przy limicie 3 tablica ma 4 elementy (indeksy 0-3),
# wiec zapis dla uchwytu 4 wychodzi dokladnie jeden element za koniec:
#
#   g_max_tx_time      @ 0x3fc97a24, 4 * 2 B = 8 B  ->  0x3fc97a24..0x3fc97a2b
#   g_max_tx_time[4]     0x3fc97a24 + 8 = 0x3fc97a2c
#   ble_gap_update_entries @ 0x3fc97a2c        <- glowa listy GAP, nadpisana
#
# Wpisywana wartosc to wynegocjowany maksymalny czas TX, czyli 0x848 = 2120 us
# (maksimum ze specyfikacji) - i dokladnie taki wskaznik-smiec widzielismy
# w crashu z AGENTS.md 4.21 (MTVAL 0x858 = 0x848 + offset pola exp_os_ticks).
#
# Dlatego padalo tylko wtedy, gdy uchwyt 4 dostawala MYSZ: ona negocjuje LE Data
# Length Extension, a klawiatura go nie wspiera (hci_err=0x21A), wiec dla niej
# zdarzenie data_len_chg nie przychodzi i zapisu nie ma.
#
# 9 to maksimum dla C3 (range 1 9), czyli tablice maja 10 elementow i pokrywaja
# kazdy uchwyt, jaki kontroler z BT_CTRL_BLE_MAX_ACT=6 moze wydac.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=9
# Tyle samo bondow, ile polaczen, plus zapas. Na sprzecie widac "bondow w NVS: 3"
# przy trzech urzadzeniach, czyli limit 3 byl wypelniony co do sztuki - a wtedy
# kazde nowe parowanie (np. klawiatura wracajaca z nowym adresem tozsamosci)
# wyrzuca jakis istniejacy bond, potencjalnie bond PC. Wtedy pad trzeba parowac
# od nowa bez zadnej widocznej przyczyny.
CONFIG_BT_NIMBLE_MAX_BONDS=5
# Domyslnie 6, czyli 3 polaczenia + skan + advertising sie mieszcza. Ustawione
# wprost, zeby bylo widoczne, ze to swiadoma wartosc, a nie przypadek.
CONFIG_BT_CTRL_BLE_MAX_ACT=6

# Pula procedur klienta GATT. Domyslne 4 jest wymiarowane pod jeden link, a u nas
# esp_hidh robi pelne odkrywanie uslug na jednym urzadzeniu, podczas gdy drugie
# strumieniuje raporty, a pad wysyla notyfikacje do PC. W crashu z 16.08.2026
# (Instruction access fault, MEPC=0x3fc98678) feralny adres lezal DOKLADNIE
# wewnatrz ble_gattc_proc_mem, czyli pamieci tej puli - stad podniesienie.
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=12

# Obie role naraz - to jest caly sens projektu. Domyslnie oba sa y, ale niech
# bedzie wpisane, bo wylaczenie ktorejkolwiek cicho zabija pol aplikacji.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y

# Klucze parowania przezywaja restart. Domyslnie jest "n" - bez tego trzeba by
# parowac klawiature, mysz i PC po kazdym resecie.
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# Bez tego AULA F99 Pro nie odda raportow: czytanie charakterystyk konczy sie
# bledem ATT "insufficient security" (status=14), a NimBLE samo nie parowalo.
# UWAGA: opcja istnieje dopiero od IDF 5.4.3 (AGENTS.md 4.1).
CONFIG_BT_NIMBLE_GATTC_AUTO_PAIR=y

# Just Works w obie strony: klawiatura i mysz nie maja wyswietlacza ani klawiatury
# numerycznej do potwierdzania kodu, PC tez tego nie wymaga dla pada.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y

# UWAGA, pulapka: ta opcja nazywa sie "HID service" i brzmi jak rzecz wylacznie
# serwerowa, ale w esp_hid gatuje ONA CALY plik nimble_hidh.c - czyli rowniez
# strone HOSTA. Bez niej linker konczy sie bledem "undefined reference to
# esp_ble_hidh_init". Musi byc "y" nawet dla czystego centrala.
# Wlaczenie samo z siebie NIE rejestruje zadnej uslugi w GATT: ble_svc_hid_init()
# jest wolane tylko z nimble_hidd.c, ktorego nie uzywamy (AGENTS.md 4.2).
CONFIG_BT_NIMBLE_HID_SERVICE=y
# Jedna instancja uslugi i jeden raport wejsciowy - tyle potrzebuje pad. Domyslne
# 2 i 3 rezerwuja wieksza strukture, a ble_svc_hid_add() bierze ja przez wartosc
# (czyli na stos wolajacego).
CONFIG_BT_NIMBLE_SVC_HID_MAX_INSTANCES=1
# Te dwie opcje wymiaruja strukture ble_svc_hid_params, ktorej JUZ NIE UZYWAMY:
# usluga HID pada jest napisana wprost na GATT w ble_gamepad.c, bo ble_svc_hid
# trzyma dlugosc Report Map w polu uint8_t i obcielaby deskryptor pada Xbox
# (334 B) do 78 B - patrz AGENTS.md 4.30. Zostawiamy najmniejsze wartosci, zeby
# nie rezerwowac BSS na nieuzywana usluge. Samej opcji BT_NIMBLE_HID_SERVICE
# wylaczyc nie mozna, bo gatuje ona takze hosta esp_hidh (4.8).
CONFIG_BT_NIMBLE_SVC_HID_MAX_RPTS=1

# Klawiatury i myszy BLE agresywnie zasypiaja i rozpadaja polaczenie. Ponawianie
# w stacku oszczedza nam wlasnej logiki reconnect.
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=y
CONFIG_BT_NIMBLE_MAX_CONN_REATTEMPT=3

# --- Aplikacja ---
# NimBLE na poziomie INFO drukuje "GATT procedure initiated: notify" przy KAZDEJ
# notyfikacji. Przy padzie 100 Hz to zalewa konsole i nie da sie znalezc wlasnych
# linii - w tescie na sprzecie 60 s logu to bylo ~3000 linii szumu. WARNING
# zostawia bledy i rzeczy, ktore faktycznie chcemy widziec.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# ble_svc_hid_add() dostaje strukture przez wartosc (~800 B przy MAX_RPTS=1),
# a wolamy je z app_main. Domyslne 3584 B jest zbyt ciasne.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120

# Etap 3: pad chodzi realnym mapowaniem wejsc, nie wzorcem testowym. Wzorzec
# zostaje jako narzedzie diagnostyczne - wlaczyc, gdy trzeba sprawdzic sam
# deskryptor HID w joy.cpl bez klawiatury i myszy.
CONFIG_APP_GAMEPAD_SELFTEST=n
