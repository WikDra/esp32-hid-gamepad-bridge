# VARIANT: USB input chip of the S3+S3 USB bridge.
#
# This chip is a USB HOST: a keyboard and a mouse hang off it through a hub, and it forwards
# their reports to the pad chip over UART. No BLE at all here.
#
# Use with:  scripts\build-native-win.bat esp32s3 s3input
#            scripts\flash-win.bat COM<n> esp32s3 s3input
#
# HARDWARE NOTE, worth reading before wiring: as a host, this chip must supply VBUS to the
# devices. A plain devkit's USB socket cannot source 5 V on its own, so use a POWERED hub -
# which also removes any doubt about a keyboard and a mouse together exceeding what the board
# could deliver.

# --- roles -------------------------------------------------------------------------------
CONFIG_APP_ENABLE_HID_HOST=n
CONFIG_APP_ENABLE_GAMEPAD=n
CONFIG_APP_USB_PAD=n
CONFIG_APP_USB_HID_HOST=y
CONFIG_APP_LINK_SENDER=y

# --- USB host ----------------------------------------------------------------------------
# Hub support is what makes "keyboard AND mouse" possible at all: without it the host serves
# exactly one directly attached device. It is a plain option in IDF 5.5.1 (ESP-IDF's own
# usb/host/hid example enables it in its defaults), not an experimental feature.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=y

# --- inter-chip link ---------------------------------------------------------------------
# Pins given EXPLICITLY, because the Kconfig defaults describe the ESP Thread BR board's
# internal S3-to-H2 wiring and are wrong here in both directions: on an esp32s3 target they
# resolve to TX=-1 (this chip would never transmit at all) and RX=17, which on an S3 SuperMini
# is not on the 18-pin side header but on the bottom pads.
#
# GPIO4/GPIO5 are plain GPIOs on that header: no strapping function (unlike GPIO0/3/45/46),
# not the USB pins (GPIO19/20), not flash or PSRAM (GPIO26-37), and not UART0 (GPIO43/44),
# which the console needs. TX is always GPIO4 and RX always GPIO5 on both boards, so the
# cable is a plain crossover: this chip's GPIO4 goes to the pad chip's GPIO5.
CONFIG_APP_LINK_TX_GPIO=4
CONFIG_APP_LINK_RX_GPIO=-1

# --- console -----------------------------------------------------------------------------
# Same hard requirement as on the pad chip: USB Serial/JTAG and USB-OTG share GPIO19/20 on
# the S3, and here USB-OTG is the host port. Console goes to UART.
#
# Default UART0 pins, which on an S3 SuperMini are the top two positions of the left header
# column (labelled TX and RX, i.e. GPIO43/GPIO44). See the pad chip's defaults for why keeping
# them beats custom pins. No clash with the link: that is UART1 on GPIO4/GPIO5.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- Configuration panel over Wi-Fi: hotkey detection only ---
# This chip has the keyboard, so it is the only one that can see Ctrl+Alt+W. It does NOT run
# Wi-Fi or the HTTP server - webui.c is not even compiled here, because that is gated on
# APP_USB_PAD. What this option adds locally is two entries in the hotkey table and one bit in
# the mode frame.
#
# Enabled on BOTH chips for the same reason APP_USB_PASSTHROUGH is: one chip sees the keystroke
# and the other acts on it. Set on only one of them, the feature looks present and does nothing -
# which is exactly the class of fault AGENTS.md 4.38 and 4.39 record.
CONFIG_APP_WEBUI=y


# --- Reverse link direction, so firmware can arrive from the pad chip ---
# The cable is crossed on both pairs: this chip's GPIO4 goes to the pad's GPIO5, and its GPIO5 to the
# pad's GPIO4. So each chip has TX on 4 and RX on 5, and the link is full duplex with no rewiring.
#
# What this chip gains is an OTA path. Its console needs the USB-UART adapter and its USB port is the
# host side, so until now every firmware change here meant holding BOOT and RESET. Direction is
# derived from these pins alone - see LINK_CAN_TX / LINK_CAN_RX in chip_link.c - so setting RX is the
# whole change on the transport side.
CONFIG_APP_LINK_RX_GPIO=5

# --- Partitions: two application slots, so firmware can be received over the link ---
# Same table as the pad variant, and the same caveat: this MOVES NVS, so the first flash with it
# wipes whatever was stored. Nothing here is worth keeping - no bonds, no profiles, the whole
# configuration lives on the pad chip.
#
# THIS CHANGE CANNOT ARRIVE BY OTA, because the OTA it enables does not exist yet. One last flash
# over BOOT+RESET, and after that updates come over the wire.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Start a freshly received image as PENDING_VERIFY and roll back unless it confirms itself. app_main
# confirms after 30 s of uptime. That matters more here than on the pad: this chip has no network of
# its own, so a bad image could only be recovered by hand.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
